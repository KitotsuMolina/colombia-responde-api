NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://colombia:change-me@localhost:5432/colombia_responde
# En Neon usa aquí la URL directa (sin `-pooler`) solo para migraciones.
DATABASE_DIRECT_URL=
DATABASE_SSL=false

REDIS_URL=redis://localhost:6379
# En Render, Upstash REST tiene prioridad; REDIS_URL conserva Redis TCP local.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

TURNSTILE_SECRET_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

LOG_LEVEL=info
ADMIN_TOKEN=
